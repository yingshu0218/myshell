{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myshell.dev/schemas/connection-v1.schema.json",
  "title": "MyShell Connection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "host", "port", "user", "proxyJump", "groupName", "tags", "notes", "terminalProfileId", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "host": { "type": "string", "minLength": 1, "maxLength": 253 },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "user": { "type": "string", "maxLength": 255 },
    "proxyJump": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 },
    "groupName": { "type": "string", "maxLength": 200 },
    "tags": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    },
    "notes": { "type": "string", "maxLength": 10000 },
    "terminalProfileId": { "type": ["string", "null"], "format": "uuid" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
