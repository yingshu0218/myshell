{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myshell.local/schemas/connection-v1.schema.json",
  "title": "MyShell connection record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "host", "port", "username", "password", "tags", "notes", "healthPeriod", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "host": { "type": "string", "minLength": 1, "maxLength": 255 },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "username": { "type": "string", "maxLength": 128 },
    "password": { "type": "string", "maxLength": 256 },
    "groupId": { "type": ["string", "null"], "format": "uuid" },
    "tags": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    },
    "notes": { "type": "string", "maxLength": 4096 },
    "terminalProfileId": { "type": ["string", "null"], "format": "uuid" },
    "hostKey": { "type": "string", "maxLength": 512 },
    "healthPeriod": { "enum": [0, 5, 15, 30, 60] },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
